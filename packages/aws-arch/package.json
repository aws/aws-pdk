    "node-fetch": "^2.6.7",
    "prettier": "2.8.8",
    "projen": "0.99.9",
    "sharp": "0.34.5",
    "tree-cli": "0.6.7",
    "ts-jest": "29.4.6",
    "typescript": "5.9.3",
    "unzipper": "0.12.3",
    "xml-flow": "1.0.4"
  },
  "peerDependencies": {
    "constructs": "10.4.5",
    "projen": "^0.99.9"
  },
  "dependencies": {
    "fs-extra": "11.3.3"
  },
  "bundledDependencies": [
    "fs-extra"
  ],
  "keywords": [
    "assets",
    "aws",
    "cfnspec",
    "icons",
    "jsii",
    "pdk",
    "projen"
  ],
  "main": "lib/index.js",
  "license": "Apache-2.0",
  "version": "0.0.0",
  "jest": {
    "coverageProvider": "v8",
    "testMatch": [
      "<rootDir>/@(src|test)/**/*(*.)@(spec|test).ts?(x)",
      "<rootDir>/@(src|test)/**/__tests__/**/*.ts?(x)"
    ],
    "clearMocks": true,
    "collectCoverage": true,
    "coverageReporters": [
      "json",
      "lcov",
      "clover",
      "cobertura",
      "text"
    ],
    "coverageDirectory": "coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "src/internal/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "src/internal/"
    ],
    "watchPathIgnorePatterns": [
      "/node_modules/"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test-reports"
        }
      ]
    ],
    "transform": {
      "^.+\\.[t]sx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.dev.json"
        }
      ]
    }
  },
  "types": "lib/index.d.ts",
  "stability": "stable",
  "jsii": {
    "outdir": "dist",
    "targets": {
      "java": {
        "package": "software.aws.pdk",
        "maven": {
          "groupId": "software.aws",
          "artifactId": "pdk"
        }
      },
      "python": {
        "distName": "aws_pdk",
        "module": "aws_pdk"
      }
    },
    "tsc": {
      "outDir": "lib",
      "rootDir": "src"
    }
  },
  "files": [
    "assets",
    "lib",
    "LICENSE_THIRD_PARTY",
    "NOTICE",
    ".jsii"
  ],
  "//": "~~ Generated by projen. To modify, edit .projenrc.js and run \"pnpm exec projen\"."
}
